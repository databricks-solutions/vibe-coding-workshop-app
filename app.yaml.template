# =============================================================================
# Databricks App Configuration (TEMPLATE)
# =============================================================================
# Generated by: vibe2value configure
# Source: app.yaml.template
#
# This file is auto-generated. Edit user-config.yaml instead, then run:
#   ./vibe2value configure
# =============================================================================
name: __APP_NAME__
description: "AI-Powered Development Workflow - Vibe Coding Workshop"

# Entry point
command:
  - "python"
  - "app.py"

# =============================================================================
# Environment Variables
# =============================================================================
env:
  # Runtime
  - name: PYTHONUNBUFFERED
    value: "1"
  - name: PORT
    value: "8000"
  
  # LLM Model endpoint
  - name: DATABRICKS_SERVING_ENDPOINT
    value: "__SERVING_ENDPOINT__"
  
  # ---------------------------------------------------------------------------
  # Lakebase PostgreSQL Configuration
  # ---------------------------------------------------------------------------
  # The bundle declares an `apps.<name>.resources[].database` binding (see
  # databricks.yml). At runtime the Apps platform auto-injects:
  #     PGHOST, PGUSER, PGDATABASE, PGPORT, PGSSLMODE, PGAPPNAME
  # ...resolved from that binding -- no manual host lookup or sed-patch is
  # needed after deploy. `src/backend/services/lakebase.py` reads PG* first
  # and falls back to LAKEBASE_* only for legacy installs.
  #
  # LAKEBASE_SCHEMA is the schema name our DDL targets. It is NOT a
  # connection attribute (Postgres connects to a database, not a schema), so
  # it is not platform-injectable and is set here explicitly.
  - name: LAKEBASE_SCHEMA
    value: "__LAKEBASE_SCHEMA__"

  # ENDPOINT_NAME -- Lakebase Autoscaling endpoint resource path.
  # Format: projects/{project_id}/branches/{branch_id}/endpoints/{endpoint_id}
  # The platform-managed binding does NOT inject PGPASSWORD because Lakebase
  # Autoscaling tokens are short-lived (~1h). The app calls
  # `client.postgres.generate_database_credential(endpoint=ENDPOINT_NAME)` on
  # demand to mint a fresh token (see services/lakebase.py). This name is
  # fully derivable from the bundle (project name + branch + literal
  # 'primary') so we ship it as a literal, not a `valueFrom`.
  - name: ENDPOINT_NAME
    value: "__ENDPOINT_NAME__"

  # Lakebase mode: "autoscaling" (default) or "provisioned"
  - name: LAKEBASE_MODE
    value: "__LAKEBASE_MODE__"

  # Toggle Lakebase (set to "false" for YAML fallback)
  - name: USE_LAKEBASE
    value: "true"

# Health check endpoint
health_check:
  path: /health
  interval_seconds: 30
  timeout_seconds: 10
  failure_threshold: 3
