{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``contrib/certifications/<certifier_id>/<contributor_id>__<slug>.yaml``",
  "properties": {
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "evidence_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Url"
    },
    "notes": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Notes",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "description": "The use case version this certification covers.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "version",
    "date",
    "notes"
  ],
  "title": "CertificationManifest",
  "type": "object"
}
