# =============================================================================
# Databricks Asset Bundle (DAB) Configuration (TEMPLATE)
# =============================================================================
# Generated by: vibe2value configure
# Source: databricks.yml.template
#
# This file is auto-generated. Edit user-config.yaml instead, then run:
#   ./vibe2value configure
# =============================================================================

bundle:
  name: vibe-coding-workshop-app

# =============================================================================
# Variables
# =============================================================================
variables:
  lakebase_instance_name:
    description: "Lakebase PostgreSQL instance name (Provisioned) or project name (Autoscaling)"
    default: "__LAKEBASE_INSTANCE_NAME__"
  lakebase_capacity:
    description: "Lakebase instance capacity (CU_1, CU_2, etc.) - Provisioned only"
    default: "CU_2"
  lakebase_min_cu:
    description: "Minimum compute units for Autoscaling endpoint (minimum 0.5)"
    default: "0.5"
  lakebase_max_cu:
    description: "Maximum compute units for Autoscaling endpoint"
    default: "2"
  lakebase_catalog:
    description: "Lakebase catalog name (Unity Catalog)"
    default: "__LAKEBASE_CATALOG__"
  lakebase_database:
    description: "Lakebase database name"
    default: "databricks_postgres"
  lakebase_schema:
    description: "Lakebase schema for configuration tables"
    default: "__LAKEBASE_SCHEMA__"
  app_name:
    description: "Databricks App name"
    default: "__APP_NAME__"

# =============================================================================
# Targets
# =============================================================================
targets:
  user:
    mode: development
    default: true
    presets:
      tags:
        project: "vibe_coding_workshop"
        environment: "development"
        managed_by: "vibe2value"
        bundle_name: "vibe-coding-workshop-app"
        # Auto-resolved from the deployer's CLI identity at deploy time -- no
        # static value needed here. Forks that prefer a literal value can set
        # it via ./vibe2value install, which re-renders this block.
        owner: ${workspace.current_user.short_name}
    # __IF_HAS_WORKSPACE_HOST__
    workspace:
      host: __WORKSPACE_HOST__
    # __ENDIF_HAS_WORKSPACE_HOST__
    variables:
      lakebase_instance_name: "__LAKEBASE_INSTANCE_NAME__"
      lakebase_catalog: "__LAKEBASE_CATALOG__"
      lakebase_schema: "__LAKEBASE_SCHEMA__"
      app_name: "__APP_NAME__"

# =============================================================================
# Resources
# =============================================================================
resources:
  # ---------------------------------------------------------------------------
  # Lakebase Provisioned Instance (legacy mode, used when ENDPOINT_NAME not set)
  # ---------------------------------------------------------------------------
  # __IF_LAKEBASE_PROVISIONED__
  database_instances:
    vibe_coding_lakebase:
      name: ${var.lakebase_instance_name}
      capacity: ${var.lakebase_capacity}

  # Lakebase Catalog/Database (only if user has CREATE CATALOG permission)
  # __IF_CREATE_CATALOG__
  database_catalogs:
    vibe_coding_catalog:
      database_instance_name: ${resources.database_instances.vibe_coding_lakebase.name}
      name: ${var.lakebase_catalog}
      database_name: ${var.lakebase_database}
      create_database_if_not_exists: true
  # __ENDIF_CREATE_CATALOG__
  # __ENDIF_LAKEBASE_PROVISIONED__

  # ---------------------------------------------------------------------------
  # Lakebase Autoscaling (default, used when ENDPOINT_NAME is set)
  # Docs: https://docs.databricks.com/aws/en/oltp/projects/manage-with-bundles
  # NOTE: postgres_endpoints is omitted -- Lakebase auto-creates a "primary"
  #       read-write endpoint per branch.  Autoscaling limits are set via CLI
  #       post-deploy in deploy.sh.
  # ---------------------------------------------------------------------------
  # __IF_LAKEBASE_AUTOSCALING__
  postgres_projects:
    vibe_coding_project:
      project_id: ${var.lakebase_instance_name}
      display_name: "Vibe Coding Workshop"
      permissions:
        - level: CAN_USE
          group_name: users
        # Pin the app SP at the project level so the bundle's declarative
        # `permissions` block doesn't get reconciled away when the platform
        # attaches the app SP via the `apps.<name>.resources[].postgres`
        # binding below. Without this entry, `bundle validate` warns and the
        # `users` group CAN_USE grant can get silently dropped at runtime.
        # The branch-level CAN_CONNECT_AND_CREATE is granted separately by
        # the app resource binding.
        - level: CAN_USE
          service_principal_name: ${resources.apps.vibe_coding_workshop.service_principal_client_id}

  postgres_branches:
    vibe_coding_branch:
      parent: ${resources.postgres_projects.vibe_coding_project.id}
      branch_id: "main"
      no_expiry: true

  # NOTE: postgres_roles are NOT declared here. With the May 2026 Apps + Lakebase
  # release, declaring an `apps.<name>.resources[].postgres` binding (below)
  # automatically creates the app SP a postgres role on the bound branch with
  # CONNECT + CREATE privileges. The 'users' group role is no longer required
  # for the canonical install; if you grant workshop attendees CAN_USE on the
  # app they reach Postgres through the app SP, not directly.
  # __ENDIF_LAKEBASE_AUTOSCALING__

  # Databricks App
  # __IF_APP_GIT_SOURCE__
  # Git-source app: bundle declares the GitHub URL + branch; on deploy, the
  # app pulls code straight from GitHub. No databricks sync required.
  # Note: `git_repository` is currently a preview field but is accepted by the
  # bundle schema. `git_source` provides the branch/tag/commit ref the bundle
  # validator requires (since `source_code_path` is omitted in this mode).
  #
  # `resources` declaratively binds the app to its Lakebase database. The
  # platform injects PGHOST / PGUSER / PGDATABASE / PGPORT / PGSSLMODE from
  # this binding at runtime (see app.yaml `valueFrom: postgres`), creates the
  # app SP a postgres role with CAN_CONNECT_AND_CREATE on the branch, and
  # rotates OAuth tokens automatically. This is the single hook that
  # converts `databricks bundle deploy` into a true one-shot install --
  # no separate role-grant step is needed.
  apps:
    vibe_coding_workshop:
      name: ${var.app_name}
      description: "AI-Powered Development Workflow - Vibe Coding Workshop"
      resources:
        - name: postgres
          description: "Lakebase Autoscaling default database for the workshop"
          postgres:
            branch: "${resources.postgres_projects.vibe_coding_project.name}/branches/main"
            database: "${resources.postgres_projects.vibe_coding_project.name}/branches/main/databases/databricks-postgres"
            permission: "CAN_CONNECT_AND_CREATE"
      git_repository:
        url: __GIT_REPO_URL__
        provider: gitHub
      git_source:
        branch: __GIT_REPO_BRANCH__
      permissions:
        - level: CAN_USE
          group_name: users
  # __ENDIF_APP_GIT_SOURCE__
  # __IF_APP_WORKSPACE_SOURCE__
  # Workspace-source app (fallback when git_repo_url is unset in user-config.yaml):
  # bundle uploads the project to a workspace folder via `databricks bundle deploy`.
  apps:
    vibe_coding_workshop:
      name: ${var.app_name}
      description: "AI-Powered Development Workflow - Vibe Coding Workshop"
      resources:
        - name: postgres
          description: "Lakebase Autoscaling default database for the workshop"
          postgres:
            branch: "${resources.postgres_projects.vibe_coding_project.name}/branches/main"
            database: "${resources.postgres_projects.vibe_coding_project.name}/branches/main/databases/databricks-postgres"
            permission: "CAN_CONNECT_AND_CREATE"
      source_code_path: .
      permissions:
        - level: CAN_USE
          group_name: users
  # __ENDIF_APP_WORKSPACE_SOURCE__

# =============================================================================
# Sync Configuration (workspace-source apps only; ignored for git-source)
# =============================================================================
# __IF_APP_WORKSPACE_SOURCE__
sync:
  include:
    - "src/**"
    - "dist/**"
    - "app.yaml"
    - "app.py"
    - "requirements.txt"
    - "scripts/**"
    - "db/**"
    - "VERSION"
  exclude:
    - "node_modules/**"
    - "__pycache__/**"
    - "*.pyc"
    - ".git/**"
    - "deploy.py"
    - "*.template"
    - "user-config.yaml*"
    - "package.json"
    - "package-lock.json"
# __ENDIF_APP_WORKSPACE_SOURCE__

# =============================================================================
# Scripts (retired)
# =============================================================================
# `scripts.post_deploy` was the previous home for SP grants + Lakebase role
# creation + DDL/seed migrations. As of the May 2026 Apps + Lakebase release
# all of those steps are now handled inline:
#   * SP postgres role / CONNECT / CREATE -- created by the
#     `apps.x.resources[].database` binding above.
#   * DDL + seed application -- run on first cold start by the FastAPI
#     lifespan handler (see app.py + src/backend/migrations.py), gated by a
#     `<schema>._migrations` ledger so re-runs are no-ops.
# `databricks bundle deploy` is now the entire install -- no `bundle run`
# follow-up is required.
#
# The legacy script is preserved at scripts/legacy/post_deploy.py for forks
# that need the imperative flow (older CLIs, customised migrations, etc.).
